{
  "name": "ANIMADOR · Estúdio Problems",
  "short_name": "Animador",
  "description": "Animação 2D quadro a quadro com personagens montados por partes",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#1b1b1b",
  "theme_color": "#232323",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icones/icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icones/icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icones/icone-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/octet-stream": [
          ".toon"
        ]
      }
    }
  ]
}