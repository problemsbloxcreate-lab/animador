{
  "name": "Estúdio Problems — Animação",
  "short_name": "Estúdio Problems",
  "description": "Editor de vídeo e animação",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f1013",
  "theme_color": "#17181c",
